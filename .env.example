# ============================================================
#  PULPO_WEB — configuración del backend
#  Copia este fichero a `.env` y rellena los valores.
#  Sin STRIPE_SECRET_KEY el backend arranca en MODO DEMO:
#  el checkout se simula y genera licencias reales sin cobrar.
# ============================================================

# Puerto del servidor
PORT=3000

# URL pública del sitio (para los redirect de Stripe)
BASE_URL=http://localhost:3000

# Secreto para firmar las claves de licencia (HMAC-SHA256).
# GENERA UNO PROPIO: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
LICENSE_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ---- Stripe (test mode) ----
# Déjalo vacío para trabajar en modo demo sin cobrar.
STRIPE_SECRET_KEY=
# Firma del webhook (stripe listen --forward-to localhost:3000/api/webhook)
STRIPE_WEBHOOK_SECRET=

# ---- Precios del plan Pro (en céntimos de euro, por host) ----
PRICE_PRO_MONTHLY=1900
PRICE_PRO_ANNUAL=18000

# Días de prueba del plan Pro
PRO_TRIAL_DAYS=14
